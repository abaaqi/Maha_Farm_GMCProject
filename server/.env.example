# ----------------------------------------------------------------
# MahaFarm API — environment variables (Phase 2)
# Copy this file to ".env" and adjust values for your machine.
# ----------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# Database — a local MongoDB or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mahafarm

# Auth / sessions
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Set true in production (HTTPS) so the session cookie is Secure + SameSite=None
COOKIE_SECURE=false

# Where the Phase 1 frontend runs (used for CORS + cookies)
CLIENT_URL=http://localhost:5173

# --- Hardware integration (Arduino + serial bridge) ---
# Shared secret the bridge/device sends in the "x-device-key" header.
# Leave blank to keep the /api/device endpoints disabled.
DEVICE_KEY=
# Optional: attach device readings to a specific farm id (defaults to the first farm).
DEVICE_FARM_ID=

# --- Foresight AI advisory layer -------------------------------------------
# Any OpenAI-compatible chat endpoint. Leave LLM_API_KEY blank and the advisory
# falls back to the built-in deterministic rules engine — the feature still works.
#   NVIDIA Build : https://integrate.api.nvidia.com/v1
#   Groq         : https://api.groq.com/openai/v1
#   OpenAI       : https://api.openai.com/v1
#   Local Ollama : http://localhost:11434/v1
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-70b-instruct
