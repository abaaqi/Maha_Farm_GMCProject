# MahaFarm serial bridge configuration

# Your deployed (or local) API base URL
API_BASE_URL=http://localhost:5000/api

# Must match DEVICE_KEY set on the API server
DEVICE_KEY=change_this_to_a_shared_secret

# Serial port the Arduino is on.
#   Windows: COM3 / COM4 …      (Device Manager → Ports)
#   macOS:   /dev/tty.usbserial-XXXX or /dev/tty.usbmodemXXXX
#   Linux:   /dev/ttyUSB0 or /dev/ttyACM0
# Run `npm run list-ports` to see what's available.
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=9600

# How often to poll the API for pending commands (ms)
POLL_INTERVAL_MS=4000
